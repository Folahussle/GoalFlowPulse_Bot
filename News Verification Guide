### Option 3: Web Scraping (Advanced)

For sites without RSS, you can scrape them:

```python
async def scrape_custom_source(url):
    """Scrape a custom website"""
    try:
        response = requests.get(url, timeout=10)
        soup = BeautifulSoup(response.content, 'html.parser')
        
        # Find news articles (you need to inspect the website HTML)
        articles = soup.find_all('div', class_='article')  # Adjust this!
        
        news_items = []
        for article in articles[:10]:
            title = article.find('h2').get_text()  # Adjust selectors!
            link = article.find('a')['href']
            
            news_items.append({
                'source': 'Custom Source',
                'title': title,
                'link': link,
                'keywords': extract_keywords(title)
            })
        
        return news_items
    except Exception as e:
        print(f"Error scraping: {e}")
        return []
```

